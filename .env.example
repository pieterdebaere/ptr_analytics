# Public URL of your analytics server (no trailing slash). Required for production.
PUBLIC_URL=https://analytics.example.com

# Number of reverse proxies in front of the server (1 for Caddy/nginx on the same host).
# Only set this when the port is reachable exclusively through that proxy
# (docker-compose.yml binds it to 127.0.0.1). If clients can reach the server directly,
# use TRUST_PROXY=false: any other value lets them forge their IP via X-Forwarded-For.
# A comma-separated list of proxy IPs/CIDRs is the strictest option.
TRUST_PROXY=1

# First admin account, created on first start only when no users exist yet.
# Choose your own values (e.g. `openssl rand -base64 24` for the password),
# start once, then delete BOTH lines again.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Country lookup: download the free DB-IP "IP to Country Lite" database (CC BY 4.0)
# monthly. Set to false when you provide your own database via GEOIP_DB_PATH.
GEOIP_AUTO_DOWNLOAD=true
# Alternatively, when a CDN sets a country header (and the origin is only reachable via
# that CDN), e.g. Cloudflare:
# GEOIP_HEADER=cf-ipcountry

# Delete analytics data older than N days (0 = keep forever).
RETENTION_DAYS=0

# Max tracking requests per visitor IP per minute.
INGEST_RATE_LIMIT=600

LOG_LEVEL=info

# ---- Hosted ("cloud") mode — leave disabled for a normal self-hosted install ----
# Public sign-up for "member" accounts (email verification is mandatory).
# Requires PUBLIC_URL=https://... and a correct TRUST_PROXY (rate limits are per client IP).
# SIGNUP_ENABLED=true
# smtps:// (implicit TLS) or smtp:// with STARTTLS (required unless SMTP_ALLOW_INSECURE=true).
# SMTP_URL=smtps://user:password@smtp.example.com:465
# SMTP_ALLOW_INSECURE=false
# MAIL_FROM=PTR Analytics <no-reply@example.com>
# Global abuse caps: sign-ups and outgoing mails per hour, pending (unverified) accounts.
# SIGNUP_MAX_PER_HOUR=200
# MAIL_MAX_PER_HOUR=500
# MAX_UNVERIFIED_ACCOUNTS=5000
# Local development only: hosted mode with an http:// PUBLIC_URL.
# ALLOW_INSECURE_PUBLIC_URL=false
# MEMBER_SITE_LIMIT=10
# TERMS_URL=https://example.com/terms
# PRIVACY_URL=https://example.com/privacy

# Per-site billing with Stripe (requires SIGNUP_ENABLED).
# BILLING_ENABLED=true
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_ID=price_...
# STRIPE_AUTOMATIC_TAX=false
# FREE_SITES=1
# PRICE_PER_SITE_CENTS=100
# PRICE_CURRENCY=eur
